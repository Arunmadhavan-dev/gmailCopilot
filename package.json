{
  "name": "inbox-copilot-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-manifest.mjs && node scripts/generate-ai-config.mjs && vite build && copy manifest.json dist\\manifest.json /Y",
    "dev": "node scripts/generate-manifest.mjs && node scripts/generate-ai-config.mjs && vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.7"
  }
}
