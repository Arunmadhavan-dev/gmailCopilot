# =============================================================================
# Gmail Copilot Extension - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth2 (Required for both dev and production)
# -----------------------------------------------------------------------------
# Get this from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Groq AI Configuration - TWO OPTIONS - Choose ONE:
# -----------------------------------------------------------------------------

# OPTION 1: DEVELOPMENT (Direct API - API key will be in bundle!)
# ---------------------------------------------------------------
# Use this for local development only. The API key will be included
# in the built extension JavaScript bundle.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WORKER_URL=

# OPTION 2: PRODUCTION (Cloudflare Worker - API key hidden securely)
# ------------------------------------------------------------------
# For production builds where you want to hide the API key.
# See workers/README.md for setup instructions.
# Set GROQ_WORKER_URL to your Cloudflare Worker URL.
# Leave GROQ_API_KEY empty when using this option.
#GROQ_API_KEY=
#GROQ_WORKER_URL=https://gmail-copilot-groq-proxy.YOUR_SUBDOMAIN.workers.dev

# Groq Model (optional, defaults to qwen/qwen3-32b)
# Available models: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3-32b

# -----------------------------------------------------------------------------
# IMPORTANT: Security
# -----------------------------------------------------------------------------
# - GOOGLE_OAUTH_CLIENT_ID: Can stay in manifest (public by OAuth2 design)
# - GROQ_API_KEY: For development only. Hide in production via Cloudflare Worker.
# - See SECURITY_AUDIT.md for full security details.
# =============================================================================
