# Google OAuth2 Client ID for Gmail API access
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Groq API Key for AI intent parsing
# Get this from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (optional, defaults to qwen/qwen3-32b)
# Other options: llama-3.1-70b-versatile, mixtral-8x7b-32768, etc.
GROQ_MODEL=qwen/qwen3-32b
